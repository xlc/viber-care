	"metadata": {
		"title": {
			"en": "Mimi Sorts Fruits and Veggies",
			"zh-Hans": "米米整理水果和蔬菜"
		},
		"description": {
			"en": "Mimi gently fills a basket and garden boxes with colorful fruits and vegetables.",
			"zh-Hans": "米米轻轻地把彩色水果和蔬菜放进篮子和菜园小盒子里。"
		},
		"ageRange": "2-4",
		"theme": "Gentle fruit and vegetable sorting",
		"sceneCount": 6
	},
	"plotPlan": {
		"mainCharacter": "Mimi, a curious toddler helping a grown-up with a quiet fruit and vegetable table.",
		"setting": "A warm kitchen basket, sunny garden stand, soft soil bed, and leafy patch.",
		"goal": "Mimi notices familiar fruits and vegetables while hearing simple bilingual food words.",
		"beginning": "Mimi starts with an empty fruit basket and finds bright fruit.",
		"middle": "Mimi adds more fruit, then moves to the garden boxes and vegetable patch.",
		"ending": "Mimi finishes at the leafy patch and looks at one calm green vegetable.",
		"emotionalTone": "Calm, warm, slow, and helpful.",
		"learningGoals": [
			"Recognize common fruit and vegetable words.",
			"Hear each important word in English and Simplified Chinese.",
			"Practice tapping visible food cards to repeat audio.",
			"Explore gentle sorting without timers, scores, or wrong answers."
		],
		"vocabulary": [
			"apple",
			"banana",
			"orange",
			"strawberry",
			"grapes",
			"watermelon",
			"carrot",
			"pumpkin",
			"tomato",
			"broccoli"
		],
		"interactionIdeas": [
			"Tap fruit to make it bounce softly.",
			"Tap vegetables for a quiet glow.",
			"Tap the watermelon for a gentle float.",
			"Replay each short line at the child's pace."
		]
	},
