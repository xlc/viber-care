			"whale",
			"fish",
			"jellyfish",
			"octopus",
			"seahorse",
			"crab",
			"seal",
			"starfish"
		],
		"interactionIdeas": [
			"Tap swimming animals for a gentle float.",
			"Tap sand animals for a soft glow.",
			"Tap the fish for a tiny bounce.",
			"Replay each short line at the child's pace."
		]
	},
