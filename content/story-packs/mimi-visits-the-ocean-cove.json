	},
	"plotPlan": {
		"mainCharacter": "Mimi, a curious toddler visiting a calm ocean cove with a grown-up nearby.",
		"setting": "A sunny ocean cove with shallow blue water, soft sand, sea grass, and quiet tide pools.",
		"goal": "Mimi notices friendly ocean animals while hearing simple bilingual sea-animal words.",
		"beginning": "Mimi starts by looking across the blue water and seeing a big whale and little fish.",
		"middle": "Mimi watches a jellyfish float, an octopus wave, and a seahorse drift near sea grass.",
		"ending": "Mimi finishes on the sand with a crab, seal, and bright starfish resting calmly.",
		"emotionalTone": "Calm, bright, gentle, slow, and wonder-filled.",
		"learningGoals": [
			"Recognize common ocean animal words.",
			"Hear each important word in English and Simplified Chinese.",
			"Practice tapping visible animals to repeat audio.",
			"Explore the ocean scene without timers, scores, or wrong answers."
		],
